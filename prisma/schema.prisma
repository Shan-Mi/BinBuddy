generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  familyId      String?   @unique
  family        Family?   @relation(fields: [familyId], references: [id])
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Family {
  id          String           @id @default(cuid())
  name        String
  email       String
  joinCode    String           @unique
  phone       String
  order       Int
  user        User?
  assignments WeekAssignment[]
  swapsFrom   Swap[]           @relation("SwapFrom")
  swapsTo     Swap[]           @relation("SwapTo")
}

// week = ISO week number (1–52); year added so the schedule can span multiple years
model WeekAssignment {
  id        String   @id @default(cuid())
  week      Int
  year      Int      @default(2026)
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([week, year])
}

model Swap {
  id             String   @id @default(cuid())
  weekNumber     Int
  toWeekNumber   Int      @default(0)
  year           Int      @default(2026)
  fromFamilyId   String
  toFamilyId     String
  fromFamily     Family   @relation("SwapFrom", fields: [fromFamilyId], references: [id])
  toFamily       Family   @relation("SwapTo", fields: [toFamilyId], references: [id])
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
